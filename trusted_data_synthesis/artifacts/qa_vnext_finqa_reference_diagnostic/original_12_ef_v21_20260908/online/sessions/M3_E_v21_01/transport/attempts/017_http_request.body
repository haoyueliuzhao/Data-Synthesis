":\"Two to eight explicitly selected accepted scalar claims/constants; maximum of selected members.\",\"minimum\":\"Two to eight explicitly selected accepted scalar claims/constants; minimum of selected members.\",\"multiply\":\"Two accepted scalar claims/constants, first * second. Scale conversions must be executed, not merely described.\",\"read\":\"One source: numeric_catalog ID; copy its signed numeric value with exact source identity. No parameters. Reading does not certify relevance or financial units.\",\"subtract\":\"Two accepted scalar claims/constants, first - second.\",\"sum\":\"Two to eight explicitly selected accepted scalar claims/constants; sum all selected members, no implicit row or period selection.\"},\"schema_version\":\"finance_qa_vnext_protocol.v2\",\"version\":\"finqa_source_numeric_h2.v2.1\"},\"protocol_id\":\"finance_qa_vnext_protocol:5d97f034b3a05b3069a0014c5f18b20d0d5b714e4c83d1b8da469a7a8f3e5985\",\"response_schemas\":{\"action\":{\"additionalProperties\":false,\"properties\":{\"inputs\":{\"items\":{\"type\":\"string\"},\"maxItems\":8,\"minItems\":1,\"title\":\"Inputs\",\"type\":\"array\"},\"kind\":{\"const\":\"action\",\"title\":\"Kind\",\"type\":\"string\"},\"operation\":{\"title\":\"Operation\",\"type\":\"string\"},\"parameters\":{\"additionalProperties\":true,\"title\":\"Parameters\",\"type\":\"object\"},\"reason\":{\"maxLength\":480,\"minLength\":1,\"title\":\"Reason\",\"type\":\"string\"},\"state_id\":{\"title\":\"State Id\",\"type\":\"string\"},\"subgoal\":{\"maxLength\":240,\"minLength\":1,\"title\":\"Subgoal\",\"type\":\"string\"}},\"required\":[\"kind\",\"state_id\",\"subgoal\",\"reason\",\"operation\",\"inputs\",\"parameters\"],\"title\":\"Action\",\"type\":\"object\"},\"final\":{\"$defs\":{\"Result\":{\"additionalProperties\":false,\"properties\":{\"unit\":{\"enum\":[\"percent\",\"USD\",\"USD_million\",\"USD_thousand\"],\"title\":\"Unit\",\"type\":\"string\"},\"value\":{\"maxLength\":256,\"pattern\":\"^-?(?:0|[1-9][0-9]*)(?:\\