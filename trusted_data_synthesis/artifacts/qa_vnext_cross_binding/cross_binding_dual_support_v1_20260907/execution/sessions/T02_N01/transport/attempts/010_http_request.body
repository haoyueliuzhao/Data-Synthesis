ublic_contract.v1:submission.schema\"},{\"error_code\":\"admission.current_state\",\"fields\":{\"/state_id\":{\"copy_from\":\"/state/id\"}},\"requirement\":\"Use this current Request's State id, not any previous State.\",\"rule_id\":\"finance_qa_action_public_contract.v1:current_state\"},{\"error_code\":\"admission.action_phase_budget\",\"fields\":{},\"requirement\":\"Action requires pending_observation=null, terminal=false, and the Runtime's preregistered Action budget not exhausted. This publication does not change that budget.\",\"rule_id\":\"finance_qa_action_public_contract.v1:action_phase_budget\"},{\"error_code\":\"admission.alternative_set\",\"fields\":{\"/decision/candidate_action_ids\":{\"all_ids_from\":\"/available_actions\",\"comparison\":\"set_equal_and_unique\",\"id_field\":\"id\",\"order_significant\":false}},\"requirement\":\"List EVERY id in the CURRENT Request's /available_actions, exactly once: set(candidate_action_ids) equals the set of all current available Action ids, and len(candidate_action_ids) equals len(set(candidate_action_ids)). This is the full available list, NOT just the selected Action, your considered subset, or one obligation's alternatives. Do not use an initial or previous State's list. Newly enabled Actions may appear after Claim acceptance; the list need not only shrink. Any permutation of this ID list is permitted. Only this field uses unordered set equality.\",\"rule_id\":\"finance_qa_action_public_contract.v1:alternative_set\"},{\"error_code\":\"admission.selected_action\",\"fields\":{\"/decision/selected_action_id\":{\"choose_id_from\":\"/available_actions\",\"id_field\":\"id\"}},\"requirement\":\"Choose ONE current available Action id yourself; this choice is separate from listing all ids.\",\"rule_id\":\"finance_qa_action_public_contract.v1:selected_action\"},{\"error_code\":\"admission.selected_action_content\",\"fields\":{\"/inputs\":{\"copy_from_selected\":\"/inputs\"},\"/operation\":{\"copy_from_selected\":\"/operation\"},\"/parameters\":{\"copy_from_selected\":\"/parameters\"}},\"requirement\":\"operation, inputs and parameters must equal the complete corresponding fields of the SAME selected Action, using existing canonical JSON equality. Preserve types, all fields, array order, roles, selectors and numeric precision; do not mix another candidate's content.\",\"rule_id\":\"finance_qa_action_public_contract.v1:selected_action_content\"},{\"error_code\":\"admission.public_judgment\",\"fields\":{\"/decision/basis\":{\"copy_from_selected\":\"/basis\"},\"/decision/expected_effect\":{\"copy_from_selected\":\"/expected_effect\"},\"/decision/obligation_id\":{\"copy_from_selected\":\"/obligation_id\"},\"/decision/selection_rule\":{\"choose_from_selected\":\"/selection_rules\"},\"/decision/subgoal\":{\"copy_from_selected\":\"/subgoal\"},\"/decision/unresolved_uncertainty_refs\":{\"literal\":[]}},\"requirement\":\"obligation_id, subgoal, basis and expected_effect must come from that SAME selected Action. Use one of its selection_rules; unresolved_uncertainty_refs must be []. basis and expected_effect use canonical JSON equality including all arrays in their given order.\",\"rule_id\":\"finance_qa_action_public_contract.v1:public_judgment\"},{\"error_code\":\"admission.input_kind\",\"fields\":{},\"requirement\":\"Each submitted input kind must be claim or evidence, while still matching the selected Action.\",\"rule_id\":\"finance_qa_action_public_contract.v1:input_kind\"},{\"error_code\":\"admission.previously_accepted_dependency\",\"fields\":{},\"requirement\":\"Every Claim id in /decision/basis/claim_refs and in inputs with kind=claim must identify a status=accepted Claim in THIS Request's /state/accepted_claims. Pending Observations and future or other-session Claims are not accepted dependencies. Original adapter and Operation input/semantic preconditions still apply; no execution occurs during this check.\",\"rule_id\":\"finance_qa_action_public_contract.v1:previously_accepted_dependency\"}],\"schema_version\":\"finance_qa_vnext_action_public_contract.v2\",\"scope\":\"existing candidate full-set, selected-offer correspondence and accepted dependencies\",\"selected_binding\":{\"id_field\":\"id\",\"match_count\":1,\"request_collection\":\"/available_actions\",\"response_selector\":\"/decision/selected_action_id\"},\"submission_schema_unchanged\":true,\"version\":\"finance_qa_action_public_contract.v1\"},\"public_update_contract\":{\"applies_when\":{\"kind\":\"update\",\"pending_observation\":\"non-null\",\"terminal\":false},\"choices_are_callback_owned\":true,\"equality\":\"existing canonical_json_bytes equality; not raw response string equality\",\"host_commits_during_calibration\":false,\"host_fills_response_fields\":false,\"id\":\"finance_qa_vnext_update_public_contract:91cc6fa63b3df80475430292668a2c3e22741cd766735a2a5044259cc4440e4c\",\"path_notation\":\"RFC 6901 JSON pointers; source paths start at this public Request\",\"rules\":[{\"error_code\":\"submission.schema\",\"fields\":{\"/disposition\":{\"choose_from_literal\":[\"accept\",\"reject\"]},\"/kind\":{\"literal\":\"update\"}},\"requirement\":\"Return one complete Update object satisfying /response_schemas/update; no extra fields.\",\"rule_id\":\"finance_qa_update_public_contract.v1:submission.schema\"},{\"error_code\":\"admission.current_state\",\"fields\":{\"/state_id\":{\"copy_from\":\"/state/id\"}},\"requirement\":\"state_id must identify this current public State.\",\"rule_id\":\"finance_qa_update_public_contract.v1:current_state\"},{\"error_code\":\"admission.terminal\",\"fields\":{},\"requirement\":\"Update requires /state/terminal=false.\",\"rule_id\":\"finance_qa_update_public_contract.v1:terminal\"},{\"error_code\":\"admission.pending_observation\",\"fields\":{},\"requirement\":\"Update requires a non-null /state/pending_observation.\",\"rule_id\":\"finance_qa_update_public_contract.v1:pending_observation\"},{\"error_code\":\"admission.observation_parent\",\"fields\":{\"/observation_id\":{\"copy_from\":\"/state/pending_observation/id\"}},\"requirement\":\"observation_id must identify the current pending Observation.\",\"rule_id\":\"finance_qa_update_public_contract.v1:observation_parent\"},{\"error_code\":\"admission.exact_observation_acceptance\",\"fields\":{\"/proposed_claim\":{\"by_disposition\":{\"accept\":{\"copy_from\":\"/state/pending_observation/proposition\"},\"reject\":{\"literal\":null}}}},\"requirement\":\"For accept, proposed_claim must equal the ENTIRE pending Observation proposition, including all outer fields, output, lineage, operation and contract fields present. Do not substitute a number, output alone, a flat Claim, the Observation wrapper, or a future Host accepted-Claim wrapper. For reject it must be null. Equality is canonical_json_bytes equality: JSON whitespace and object key order may differ; preserve all fields, JSON types, strings, array order and exact numeric content. No rounding, tolerance, coercion, omitted fields or extra fields.\",\"rule_id\":\"finance_qa_update_public_contract.v1:exact_observation_acceptance\"},{\"error_code\":\"admission.observation_assessment\",\"fields\":{\"/assessment/evidence_refs\":{\"copy_from\":\"/state/pending_observation/proposition/lineage\"},\"/assessment/fulfills_obligation\":{\"by_disposition\":{\"accept\":{\"copy_from\":\"/state/pending_observation/obligation_id\"},\"reject\":{\"literal\":null}}},\"/assessment/observation_refs\":{\"wrap_in_list_from\":\"/state/pending_observation/id\"},\"/assessment/relation\":{\"by_disposition\":{\"accept\":{\"literal\":\"accepts_observed_proposition\"},\"reject\":{\"literal\":\"declines_observation\"}}}},\"requirement\":\"assessment must have exactly these four fields with canonical JSON equality; observation_refs is the singleton current Observation id; evidence_refs is the complete ordered lineage array, not a subset or reordered set.\",\"rule_id\":\"finance_qa_update_public_contract.v1:observation_assessment\"},{\"error_code\":\"admission.update_effect\",\"fields\":{\"/newly_enabled_obligation_ids\":{\"by_disposition\":{\"accept\":{\"copy_from\":\"/update_transition_options/accept/newly_enabled_obligation_ids\"},\"reject\":{\"copy_from\":\"/update_transition_options/reject/newly_enabled_obligation_ids\"}}},\"/next_subgoal\":{\"by_disposition\":{\"accept\":{\"choose_from\":\"/update_transition_options/accept/allowed_next_subgoals\"},\"reject\":{\"choose_from\":\"/update_transition_options/reject/allowed_next_subgoals\"}}},\"/remaining_uncertainty_refs\":{\"by_disposition\":{\"accept\":{\"copy_from\":\"/update_transition_options/accept/remaining_uncertainty_refs\"},\"reject\":{\"copy_from\":\"/update_transition_options/reject/remaining_uncertainty_refs\"}}}},\"requirement\":\"Use the transition branch matching disposition. The two reference arrays must equal the provided ordered arrays exactly. next_subgoal must be one member of allowed_next_subgoals (a string, not the whole array).\",\"rule_id\":\"finance_qa_update_public_contract.v1:update_effect\"}],\"schema_version\":\"finance_qa_vnext_update_public_contract.v2\",\"submission_schema_unchanged\":true,\"version\":\"finance_qa_update_public_contract.v1\"},\"response_schemas\":{\"action\":{\"$defs\":{\"Basis\":{\"additionalProperties\":false,\"properties\":{\"claim_refs\":{\"items\":{\"type\":\"string\"},\"title\":\"Claim Refs\",\"type\":\"array\"},\"evidence_refs\":{\"items\":{\"type\":\"string\"},\"title\":\"Evidence Refs\",\"type\":\"array\"},\"relation\":{\"const\":\"requires\",\"title\":\"Relation\",\"type\":\"string\"}},\"required\":[\"relation\",\"evidence_refs\",\"claim_refs\"],\"title\":\"Basis\",\"type\":\"object\"},\"Decision\":{\"additionalProperties\":false,\"properties\":{\"basis\":{\"$ref\":\"#/$defs/Basis\"},\"candidate_action_ids\":{\"items\":{\"type\":\"string\"},\"minItems\":1,\"title\":\"Candidate Action Ids\",\"type\":\"array\"},\"expected_effect\":{\"$ref\":\"#/$defs/Effect\"},\"obligation_id\":{\"title\":\"Obligation Id\",\"