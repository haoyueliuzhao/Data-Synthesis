"36.84063334376945780229289863"},"step_id":"answer"}],"is_Teacher_trajectory":false,"model_session_id":null,"operator_dag":{"operators":[{"inputs":[{"binding":"component_0"},{"binding":"component_1"},{"binding":"component_2"},{"binding":"component_3"}],"operator":"linear_combination","params":{"coefficients":[1,1,1,1]},"step_id":"change"},{"inputs":[{"step":"change"},{"binding":"positive_base"}],"operator":"ratio_percent","step_id":"answer"}],"output_step":"answer"},"origin":"deterministic_QA_reference_executor","output":{"currency":null,"lineage":{"input_entity_ids":["NOW_US"],"input_fact_ids":["fact_acad93d4be0b7d4c94bd4567__fact_build_20260911_180340_fd3a326c","fact_be8e3198fa62a9655ee9fa23__fact_build_20260911_180340_fd3a326c","fact_c92992944c2df9afe6e46637__fact_build_20260911_180340_fd3a326c","fact_d839ed6871190b42c758c795__fact_build_20260911_180340_fd3a326c","fact_f1a69317314fe5fde0a804ce__fact_build_20260911_180340_fd3a326c"],"input_periods":[],"input_step_ids":["change"],"selected_entity_ids":[],"selected_fact_ids":[],"selected_periods":[]},"unit":"percent","value":"36.84063334376945780229289863"},"schema_version":"finance_qa_vnext_task_build.v1.oracle_basis_witness"}]}},"public":{"quantity_contract":{"currency":null,"decimal_places":2,"rounding":"half away from zero","unit":"percent"},"question":"At the end of 2019-12-31, how much had ServiceNow, Inc.'s Cash, Cash Equivalents, Restricted Cash and Restricted Cash Equivalents changed from the prior fiscal-year end, in percentage terms? In the answer, express the value in percent and round to 2 decimal places.","source_policy":"Use only these original records, their explicit periods, units and native definitions.","sources":[{"concept":"us-gaap:CashCashEquivalentsRestrictedCashAndRestrictedCashEquivalents","definition":"Amount of cash and cash equivalents, and cash and cash equivalents restricted to withdrawal or usage. Excludes amount for disposal group and discontinued operations. Cash includes, but is not limited to, currency on hand, demand deposits with banks or financial institutions, and other accounts with general characteristics of demand deposits. Cash equivalents include, but are not limited to, short-term, highly liquid investments that are both readily convertible to known amounts of cash and so near their maturity that they present insignificant risk of changes in value because of changes in interest rates.","label":"Cash, Cash Equivalents, Restricted Cash and Restricted Cash Equivalents","native_pointer":"/facts/us-gaap/CashCashEquivalentsRestrictedCashAndRestrictedCashEquivalents/units/USD/28","original_url":"https://data.sec.gov/api/xbrl/companyfacts/CIK0001373715.json?cik=0001373715&ticker=NOW","raw_sha256":"053113721f5b4ff09e957506d17f95f2da4a91c4b01e5002a75af9ce87670b98","record":{"accn":"0001373715-19-000070","end":"2018-12-31","filed":"2019-02-27","form":"10-K","fp":"FY","fy":2018,"val":568538000},"source_id":"fact_c92992944c2df9afe6e46637__fact_build_20260911_180340_fd3a326c","unit":"USD"},{"concept":"us-gaap:CashCashEquivalentsRestrictedCashAndRestrictedCashEquivalents","definition":"Amount of cash and cash equivalents, and cash and cash equivalents restricted to withdrawal or usage. Excludes amount for disposal group and discontinued operations. Cash includes, but is not limited to, currency on hand, demand deposits with banks or financial institutions, and other accounts with general characteristics of demand deposits. Cash equivalents include, but are not limited to, short-term, highly liquid investments that are both readily convertible to known amounts of cash and so near their maturity that they present insignificant risk of changes in value because of changes in interest rates.","label":"Cash, Cash Equivalents, Restricted Cash and Restricted Cash Equivalents","native_pointer":"/facts/us-gaap/CashCashEquivalentsRestrictedCashAndRestrictedCashEquivalents/units/USD/44","original_url":"https://data.sec.gov/api/xbrl/companyfacts/CIK0001373715.json?cik=0001373715&ticker=NOW","raw_sha256":"053113721f5b4ff09e957506d17f95f2da4a91c4b01e5002a75af9ce87670b98","record":{"accn":"0001373715-20-000072","end":"2019-12-31","filed":"2020-02-20","form":"10-K","fp":"FY","fy":2019,"val":777991000},"source_id":"fact_84862bc7ac2092e72b1458c3__fact_build_20260911_180340_fd3a326c","unit":"USD"},{"concept":"us-gaap:EffectOfExchangeRateOnCashCashEquivalentsRestrictedCashAndRestrictedCashEquivalents","definition":"Amount of increase (decrease) from effect of exchange rate changes on cash and cash equivalents, and cash and cash equivalents restricted to withdrawal or usage; held in foreign currencies. Excludes amounts for disposal group and discontinued operations. Cash includes, but is not limited to, currency on hand, demand deposits with banks or financial institutions, and other accounts with general characteristics of demand deposits. Cash equivalents include, but are not limited to, short-term, highly liquid investments that are both readily convertible to known amounts of cash and so near their maturity that they present insignificant risk of changes in value because of changes in interest rates.","label":"Effect of Exchange Rate on Cash, Cash Equivalents, Restricted Cash and Restricted Cash Equivalents","native_pointer":"/facts/us-gaap/EffectOfExchangeRateOnCashCashEquivalentsRestrictedCashAndRestrictedCashEquivalents/units/USD/24","original_url":"https://data.sec.gov/api/xbrl/companyfacts/CIK0001373715.json?cik=0001373715&ticker=NOW","raw_sha256":"053113721f5b4ff09e957506d17f95f2da4a91c4b01e5002a75af9ce87670b98","record":{"accn":"0001373715-20-000072","end":"2019-12-31","filed":"2020-02-20","form":"10-K","fp":"FY","fy":2019,"start":"2019-01-01","val":-186000},"source_id":"fact_f1a69317314fe5fde0a804ce__fact_build_20260911_180340_fd3a326c","unit":"USD"},{"concept":"us-gaap:NetCashProvidedByUsedInFinancingActivities","definition":"Amount of cash inflow (outflow) from financing activities, including discontinued operations. Financing activity cash flows include obtaining resources from owners and providing them with a return on, and a return of, their investment; borrowing money and repaying amounts borrowed, or settling the obligation; and obtaining and paying for other resources obtained from creditors on long-term credit.","label":"Net Cash Provided by (Used in) Financing Activities","native_pointer":"/facts/us-gaap/NetCashProvidedByUsedInFinancingActivities/units/USD/77","original_url":"https://data.sec.gov/api/xbrl/companyfacts/CIK0001373715.json?cik=0001373715&ticker=NOW","raw_sha256":"053113721f5b4ff09e957506d17f95f2da4a91c4b01e5002a75af9ce87670b98","record":{"accn":"0001373715-20-000072","end":"2019-12-31","filed":"2020-02-20","form":"10-K","fp":"FY","fy":2019,"start":"2019-01-01","val":-301856000},"source_id":"fact_d839ed6871190b42c758c795__fact_build_20260911_180340_fd3a326c","unit":"USD"},{"concept":"us-gaap:NetCashProvidedByUsedInInvestingActivities","definition":"Amount of cash inflow (outflow) from investing activities, including discontinued operations. Investing activity cash flows include making and collecting loans and acquiring and disposing of debt or equity instruments and property, plant, and equipment and other productive assets.","label":"Net Cash Provided by (Used in) Investing Activities","native_pointer":"/facts/us-gaap/NetCashProvidedByUsedInInvestingActivities/units/USD/77","original_url":"https://data.sec.gov/api/xbrl/companyfacts/CIK0001373715.json?cik=0001373715&ticker=NOW","raw_sha256":"053113721f5b4ff09e957506d17f95f2da4a91c4b01e5002a75af9ce87670b98","record":{"accn":"0001373715-20-000072","end":"2019-12-31","filed":"2020-02-20","form":"10-K","fp":"FY","fy":2019,"start":"2019-01-01","val":-724477000},"source_id":"fact_be8e3198fa62a9655ee9fa23__fact_build_20260911_180340_fd3a326c","unit":"USD"},{"concept":"us-gaap:NetCashProvidedByUsedInOperatingActivities","definition":"Amount of cash inflow (outflow) from operating activities, including discontinued operations. Operating activity cash flows include transactions, adjustments, and changes in value not defined as investing or financing activities.","label":"Net Cash Provided by (Used in) Operating Activities","native_pointer":"/facts/us-gaap/NetCashProvidedByUsedInOperatingActivities/units/USD/77","original_url":"https://data.sec.gov/api/xbrl/companyfacts/CIK0001373715.json?cik=0001373715&ticker=NOW","raw_sha256":"053113721f5b4ff09e957506d17f95f2da4a91c4b01e5002a75af9ce87670b98","record":{"accn":"0001373715-20-000072","end":"2019-12-31","filed":"2020-02-20","form":"10-K","fp":"FY","fy":2019,"start":"2019-01-01","val":1235972000},"source_id":"fact_acad93d4be0b7d4c94bd4567__fact_build_20260911_180340_fd3a326c","unit":"USD"}],"tool_contract":{"Final":"Return the requested quantity and units.","calculate":"Evaluate explicit arithmetic over numeric source values; do not assume hidden references."}},"schema_version":"finance_qa_vnext_task_build.v1.TaskBundle","source_cluster":"cik:0001373715","split":"train","task_id":"task_776c2fc5ee01e6c87969951c3872e14e8679ad206164ecb5c0e84d3e933e89d6","tokenizer_artifacts":[],"training_materials":[],"validation":{"all_leaf_source_use_checked_again_at_export":true,"independent_target_recompute":"36.84063334376945780229289863","native_value_period_definition_checked_again_at_export":true,"persisted_question_roundtrip_checked_by_QA_pipeline":true,"qa_check_ids":["qacheck_3565321fa6aadb204c90a0ae","qacheck_a8c7714cc44eec19457fac93","qacheck_16517ab2a017c04069bf386c","qacheck_88bbaa0760331a55de68c620","qacheck_780c8970f65873e669e61662","qacheck_1031abb73f934a12611a1d6d","qacheck_e158d4e54a1f51ddadfc6cc7","qacheck_9e4206d32019decc1f8a0e09","qacheck_27ad2254677ac2de9c4f83ec","qacheck_ff8127b802f45bdfe3857d63","qacheck_48d97a13f21fb0d5c014fd74","qacheck_b67882f558b33c58eaa2239c","qacheck_fd3916adf605fcbef323d96d","qacheck_8f036789c6a58a6861d6a50a","qacheck_5dc244ecc89fe02c1a74ae5f","qacheck_b1ee8d8786bcc472db389bcc","qacheck_42f1559d41d53e