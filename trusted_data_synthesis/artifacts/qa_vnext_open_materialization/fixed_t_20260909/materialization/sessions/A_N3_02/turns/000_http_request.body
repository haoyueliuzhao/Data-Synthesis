ndex\":0,\"segment\":\"q14\",\"start\":33,\"token\":\"2011\",\"value\":\"2011\"},{\"end\":91,\"id\":\"source:q14n1\",\"index\":1,\"segment\":\"q14\",\"start\":87,\"token\":\"2019\",\"value\":\"2019\"},{\"end\":30,\"id\":\"source:q16n0\",\"index\":0,\"segment\":\"q16\",\"start\":28,\"token\":\"31\",\"value\":\"31\"},{\"end\":37,\"id\":\"source:q16n1\",\"index\":1,\"segment\":\"q16\",\"start\":33,\"token\":\"2010\",\"value\":\"2010\"},{\"end\":46,\"id\":\"source:q16n2\",\"index\":2,\"segment\":\"q16\",\"start\":42,\"token\":\"2009\",\"value\":\"2009\"},{\"end\":77,\"id\":\"source:q16n3\",\"index\":3,\"segment\":\"q16\",\"start\":73,\"token\":\"25.0\",\"value\":\"25\"},{\"end\":96,\"id\":\"source:q16n4\",\"index\":4,\"segment\":\"q16\",\"start\":92,\"token\":\"24.0\",\"value\":\"24\"},{\"end\":163,\"id\":\"source:q16n5\",\"index\":5,\"segment\":\"q16\",\"start\":160,\"token\":\"9.7\",\"value\":\"97/10\"},{\"end\":182,\"id\":\"source:q16n6\",\"index\":6,\"segment\":\"q16\",\"start\":178,\"token\":\"10.2\",\"value\":\"51/5\"},{\"end\":7,\"id\":\"source:q17n0\",\"index\":0,\"segment\":\"q17\",\"start\":5,\"token\":\"29\",\"value\":\"29\"},{\"end\":12,\"id\":\"source:q17n1\",\"index\":1,\"segment\":\"q17\",\"start\":8,\"token\":\"2013\",\"value\":\"2013\"},{\"end\":80,\"id\":\"source:q18n0\",\"index\":0,\"segment\":\"q18\",\"start\":76,\"token\":\"2019\",\"value\":\"2019\"},{\"end\":55,\"id\":\"source:q19n0\",\"index\":0,\"segment\":\"q19\",\"start\":54,\"token\":\"1\",\"value\":\"1\"},{\"end\":74,\"id\":\"source:q19n1\",\"index\":1,\"segment\":\"q19\",\"start\":73,\"token\":\"2\",\"value\":\"2\"},{\"end\":6,\"id\":\"source:q20n0\",\"index\":0,\"segment\":\"q20\",\"start\":5,\"token\":\"1\",\"value\":\"1\"},{\"end\":51,\"id\":\"source:q20n1\",\"index\":1,\"segment\":\"q20\",\"start\":47,\"token\":\"2019\",\"value\":\"2019\"},{\"end\":6,\"id\":\"source:q21n0\",\"index\":0,\"segment\":\"q21\",\"start\":5,\"token\":\"2\",\"value\":\"2\"},{\"end\":67,\"id\":\"source:q21n1\",\"index\":1,\"segment\":\"q21\",\"start\":66,\"token\":\"1\",\"value\":\"1\"},{\"end\":140,\"id\":\"source:q21n2\",\"index\":2,\"segment\":\"q21\",\"start\":139,\"token\":\"2\",\"value\":\"2\"},{\"end\":23,\"id\":\"source:q22n0\",\"index\":0,\"segment\":\"q22\",\"start\":22,\"token\":\"1\",\"value\":\"1\"},{\"end\":43,\"id\":\"source:q22n1\",\"index\":1,\"segment\":\"q22\",\"start\":42,\"token\":\"2\",\"value\":\"2\"},{\"end\":129,\"id\":\"source:q23n0\",\"index\":0,\"segment\":\"q23\",\"start\":128,\"token\":\"1\",\"value\":\"1\"},{\"end\":238,\"id\":\"source:q23n1\",\"index\":1,\"segment\":\"q23\",\"start\":237,\"token\":\"1\",\"value\":\"1\"},{\"end\":17,\"id\":\"source:q26n0\",\"index\":0,\"segment\":\"q26\",\"start\":15,\"token\":\"31\",\"value\":\"31\"},{\"end\":24,\"id\":\"source:q26n1\",\"index\":1,\"segment\":\"q26\",\"start\":20,\"token\":\"2010\",\"value\":\"2010\"},{\"end\":33,\"id\":\"source:q26n2\",\"index\":2,\"segment\":\"q26\",\"start\":29,\"token\":\"2009\",\"value\":\"2009\"}],\"question\":\"in 2010 and 2009 , what was the total fair value in billions of assets segregated for the benefit of securities and futures brokerage customers?\",\"schema_version\":\"autonomous_formula_thinking.v1.public_document\",\"segments\":{\"p0\":{\"locator\":[\"pre_text\",0],\"text\":\"jpmorgan chase & co./2010 annual report 273 the following table presents the u.s .\"},\"p1\":{\"locator\":[\"pre_text\",1],\"text\":\"and non-u.s .\"},\"p2\":{\"locator\":[\"pre_text\",2],\"text\":\"components of income before income tax expense/ ( benefit ) and extraordinary gain for the years ended december 31 , 2010 , 2009 and 2008 .\"},\"p3\":{\"locator\":[\"pre_text\",3],\"text\":\"year ended december 31 , ( in millions ) 2010 2009 2008 .\"},\"q0\":{\"locator\":[\"post_text\",0],\"text\":\"non-u.s. ( a ) 8291 9804 4867 income before income tax expense/ ( benefit ) and extraordinary gain $ 24859 $ 16067 $ 2773 ( a ) for purposes of this table , non-u.s .\"},\"q1\":{\"locator\":[\"post_text\",1],\"text\":\"income is defined as income generated from operations located outside the u.s .\"},\"q10\":{\"locator\":[\"post_text\",10],\"text\":\"such secured loans to the firm or to other affiliates are generally limited to 10% ( 10 % ) of the banking subsidiary 2019s total capital , as determined by the risk- based capital guidelines ; the aggregate amount of all such loans is limited to 20% ( 20 % ) of the banking subsidiary 2019s total capital .\"},\"q11\":{\"locator\":[\"post_text\",11],\"text\":\"the principal sources of jpmorgan chase 2019s income ( on a parent company 2013only basis ) are dividends and interest from jpmorgan chase bank , n.a. , and the other banking and nonbanking subsidi- aries of jpmorgan chase .\"},\"q12\":{\"locator\":[\"post_text\",12],\"text\":\"in addition to dividend restrictions set forth in statutes and regulations , the federal reserve , the occ and the fdic have authority under the financial institutions supervisory act to prohibit or to limit the payment of dividends by the banking organizations they supervise , including jpmorgan chase and its subsidiaries that are banks or bank holding companies , if , in the banking regulator 2019s opinion , payment of a dividend would consti- tute an unsafe or unsound practice in light of the financial condi- tion of the banking organization .\"},\"q13\":{\"locator\":[\"post_text\",13],\"text\":\"at january 1 , 2011 , jpmorgan chase 2019s banking subsidiaries could pay , in the aggregate , $ 2.0 billion in dividends to their respective bank holding companies without the prior approval of their relevant banking regulators .\"},\"q14\":{\"locator\":[\"post_text\",14],\"text\":\"the capacity to pay dividends in 2011 will be supplemented by the banking subsidiaries 2019 earnings during the in compliance with rules and regulations established by u.s .\"},\"q15\":{\"locator\":[\"post_text\",15],\"text\":\"and non-u.s .\"},\"q16\":{\"locator\":[\"post_text\",16],\"text\":\"regulators , as of december 31 , 2010 and 2009 , cash in the amount of $ 25.0 billion and $ 24.0 billion , respectively , and securities with a fair value of $ 9.7 billion and $ 10.2 billion , respec- tively , were segregated in special bank accounts for the benefit of securities and futures brokerage customers .\"},\"q17\":{\"locator\":[\"post_text\",17],\"text\":\"note 29 2013 capital the federal reserve establishes capital requirements , including well-capitalized standards for the consolidated financial holding company .\"},\"q18\":{\"locator\":[\"post_text\",18],\"text\":\"the occ establishes similar capital requirements and standards for the firm 2019s national banks , including jpmorgan chase bank , n.a. , and chase bank usa , n.a .\"},\"q19\":{\"locator\":[\"post_text\",19],\"text\":\"there are two categories of risk-based capital : tier 1 capital and tier 2 capital .\"},\"q2\":{\"locator\":[\"post_text\",2],\"text\":\"note 28 2013 restrictions on cash and intercompany funds transfers the business of jpmorgan chase bank , national association ( 201cjpmorgan chase bank , n.a . 201d ) is subject to examination and regulation by the office of the comptroller of the currency ( 201cocc 201d ) .\"},\"q20\":{\"locator\":[\"post_text\",20],\"text\":\"tier 1 capital consists of common stockholders 2019 equity , perpetual preferred stock , noncontrolling interests in sub- sidiaries and trust preferred capital debt securities , less goodwill and certain other adjustments .\"},\"q21\":{\"locator\":[\"post_text\",21],\"text\":\"tier 2 capital consists of preferred stock not qualifying as tier 1 , subordinated long-term debt and other instruments qualifying as tier 2 , and the aggregate allowance for credit losses up to a certain percentage of risk-weighted assets .\"},\"q22\":{\"locator\":[\"post_text\",22],\"text\":\"total capital is tier 1 capital plus tier 2 capital .\"},\"q23\":{\"locator\":[\"post_text\",23],\"text\":\"under the risk- based capital guidelines of the federal reserve , jpmorgan chase is required to maintain minimum ratios of tier 1 and total capital to risk-weighted assets , as well as minimum leverage ratios ( which are defined as tier 1 capital divided by adjusted quarterly average assets ) .\"},\"q24\":{\"locator\":[\"post_text\",24],\"text\":\"failure to meet these minimum requirements could cause the federal reserve to take action .\"},\"q25\":{\"locator\":[\"post_text\",25],\"text\":\"banking subsidiaries also are subject to these capital requirements by their respective primary regulators .\"},\"q26\":{\"locator\":[\"post_text\",26],\"text\":\"as of december 31 , 2010 and 2009 , jpmorgan chase and all of its banking subsidiaries were well-capitalized and met all capital requirements to which each was subject. .\"},\"q3\":{\"locator\":[\"post_text\",3],\"text\":\"the bank is a member of the u.s .\"},\"q4\":{\"locator\":[\"post_text\",4],\"text\":\"federal reserve sys- tem , and its deposits in the u.s .\"},\"q5\":{\"locator\":[\"post_text\",5],\"text\":\"are insured by the fdic .\"},\"q6\":{\"locator\":[\"post_text\",6],\"text\":\"the board of governors of the federal reserve system ( the 201cfed- eral reserve 201d ) requires depository institutions to maintain cash reserves with a federal reserve bank .\"},\"q7\":{\"locator\":[\"post_text\",7],\"text\":\"the average amount of reserve balances deposited by the firm 2019s bank subsidiaries with various federal reserve banks was approximately $ 803 million and $ 821 million in 2010 and 2009 , respectively .\"},\"q8\":{\"locator\":[\"post_text\",8],\"text\":\"restrictions imposed by u.s .\"},\"q9\":{\"locator\":[\"post_text\",9],\"text\":\"federal law prohibit jpmorgan chase and certain of its affiliates from borrowing from banking subsidiar- ies unless the loans are secured in specified amounts .\"},\"t0c0\":{\"column_label\":\"year ended december 31 ( in millions )\",\"locator\":[\"table\",0,0],\"row_label\":\"year ended december 31 ( in millions )\",\"text\":\"year ended december 31 ( in millions )\"},\"t0c1\":{\"column_label\":\"2010\",\"locator\":[\"table\",0,1],\"row_label\":\"year ended december 31 ( in millions )\",\"text\":\"2010\"},\"t0c2\":{\"column_label\":\"2009\",\"locator\":[\"table\",0,2],\"row_label\":\"year ended december 31 ( in millions )\",\"text\":\"2009\"},\"t0c3\":{\"column_label\":\"2008\",\"locator\":[\"table\",0,3],\"row_label\":\"year ended december 31 ( in millions )\",\"text\":\"2008\"},\"t1c0\":{\"column_label\":\"year ended december 31 ( in millions )\",\"locator\":[\"table\",1,0],\"row_label\":\"u.s .\",\"text\":\"u.s .\"},\"t1c1\":{\"column_label\":\"2010\",\"locator\":[\"table\",1,1],\"row_label\":\"u.s .\",\"text\":\"$ 16568\"},\"t1c2\":{\"column_label\":\"2009\",\"locator\":[\"table\",1,2],\"row_label\":\"u.s .\",\"text\":\"$ 6263\"},\"t1c3\":{\"column_label\":\"2008\",\"locator\":[\"table\",1,3],\"row_label\":\"u.s .\",\"text\":\"$ -2094 ( 2094 )\"},\"t2c0\":{\"column_label\":\"year ended december 31 ( in millions )\",\"locator\":[\"table\",2,0],\"row_label\":\"non-u.s. ( a )\",\"text\":\"non-u.s. ( a )\"},\"t2c1\":{\"column_label\":\"2010\",\"locator\":[\"table\",2,1],\"row_label\":\"non-u.s. ( a )\",\"text\":\"8291\"},\"t2c2\":{\"column_label\":\"2009\",\"locator\":[\"table\",2,2],\"row_label\":\"non-u.s. ( a )\",\"text\":\"9804\"},\"t2c3\":{\"column_label\":\"2008\",\"locator\":[\"table\",2,3],\"row_label\":\"non-u.s. ( a )\",\"text\":\"4867\"},\"t3c0\":{\"column_label\":\"year ended december 31 ( in millions )\",\"locator\":[\"table\",3,0],\"row_label\":\"income before incometax expense/ ( benefit ) andextraordinary gain\",\"text\":\"income before incometax expense/ ( benefit ) andextraordinary gain\"},\"t3c1\":{\"column_label\":\"2010\",\"locator\":[\"table\",3,1],\"row_label\":\"income before incometax expense/ ( benefit ) andextraordinary gain\",\"text\":\"$ 24859\"},\"t3c2\":{\"column_label\":\"2009\",\"locator\":[\"table\",3,2],\"row_label\":\"income before incometax expense/ ( benefit ) andextraordinary gain\",\"text\":\"$ 16067\"},\"t3c3\":{\"column_label\":\"2008\",\"locator\":[\"table\",3,3],\"row_label\":\"income before incometax expense/ ( benefit ) andextraordinary gain\",\"text\":\"$ 2773\"}},\"source\":{\"post_text\":[\"non-u.s. ( a ) 8291 9804 4867 income before income tax expense/ ( benefit ) and extraordinary gain $ 24859 $ 16067 $ 2773 ( a ) for purposes of this table , non-u.s .\",\"income is defined as income generated from operations located outside the u.s .\",\"note 28 2013 restrictions on cash and intercompany funds transfers the business of jpmorgan chase bank , national association ( 201cjpmorgan chase bank , n.a . 201d ) is subject to examination and regulation by the office of the comptroller of the currency ( 201cocc 201d ) .\",\"the bank is a member of the u.s .\",\"federal reserve sys- tem , and its deposits in the u.s .\",\"are insured by the fdic .\",\"the board of governors of the federal reserve system ( the 201cfed- eral reserve 201d ) requires depository institutions to maintain cash reserves with a federal reserve bank .\",\"the average amount of reserve balances deposited by the firm 2019s bank subsidiaries with various federal reserve banks was approximately $ 803 million and $ 821 million in 2010 and 2009 , respectively .\",\"restrictions imposed by u.s .\",\"federal law prohibit jpmorgan chase and certain of its affiliates from borrowing from banking subsidiar- ies unless the loans are secured in specified amounts .\",\"such secured loans to the firm or to other affiliates are generally limited to 10% ( 10 % ) of the banking subsidiary 2019s total capital , as determined by the risk- based capital guidelines ; the aggregate amount of all such loans is limited to 20% ( 20 % ) of the banking subsidiary 2019s total capital .\",\"the principal sources of jpmorgan chase 2019s income ( on a parent company 2013only basis ) are dividends and interest from jpmorgan chase bank , n.a. , and the other banking and nonbanking subsidi- aries of jpmorgan chase .\",\"in addition to dividend restrictions set forth in statutes and regulations , the federal reserve , the occ and the fdic have authority under the financial institutions supervisory act to prohibit or to limit the payment of dividends by the banking organizations they supervise , including jpmorgan chase and its subsidiaries that are banks or bank holding companies , if , in the banking regulator 2019s opinion , payment of a dividend would consti- tute an unsafe or unsound practice in light of the financial condi- tion of the banking organization .\",\"at january 1 , 2011 , jpmorgan chase 2019s banking subsidiaries could pay , in the aggregate , $ 2.0 billion in dividends to their respective bank holding companies without the prior approval of their relevant banking regulators .\",\"the capacity to pay dividends in 2011 will be supplemented by the banking subsidiaries 2019 earnings during the in compliance with rules and regulations established by u.s .\",\"and non-u.s .\",\"regulators , as of december 31 , 2010 and 2009 , cash in the amount of $ 25.0 billion and $ 24.0 billion , respectively , and securities with a fair value of $ 9.7 billion and $ 10.2 billion , respec- tively , were segregated in special bank accounts for the benefit of securities and futures brokerage customers .\",\"note 29 2013 capital the federal reserve establishes capital requirements , including well-capitalized standards for the consolidated financial holding company .\",\"the occ establishes similar capital requirements and standards for the firm 2019s national banks , including jpmorgan chase bank , n.a. , and chase bank usa , n.a .\",\"there are two categories of risk-based capital : tier 1 capital and tier 2 capital .\",\"tier 1 capital consists of common stockholders 2019 equity , perpetual preferred stock , noncontrolling interests in sub- sidiaries and trust preferred capital debt securities , less goodwill and certain other adjustments .\",\"tier 2 capital consists of preferred stock not qualifying as tier 1 , subordinated long-term debt and other instruments qualifying as tier 2 , and the aggregate allowance for credit losses up to a certain percentage of risk-weighted assets .\",\"total capital is tier 1 capital plus tier 2 capital .\",\"under the risk- based capital guidelines of the federal reserve , jpmorgan chase is required to maintain minimum ratios of tier 1 and total capital to risk-weighted assets , as well as minimum leverage ratios ( which are defined as tier 1 capital divided by adjusted quarterly average assets ) .\",\"failure to meet these minimum requirements could cause the federal reserve to take action .\",\"banking subsidiaries also are subject to these capital requirements by their respective primary regulators .\",\"as of december 31 , 2010 and 2009 , jpmorgan chase and all of its banking subsidiaries were well-capitalized and met all capital requirements to which each was subject. .\"],\"pre_text\":[\"jpmorgan chase & co./2010 annual report 273 the following table presents the u.s .\",\"and non-u.s .\",\"components of income before income tax expense/ ( benefit ) and extraordinary gain for the years ended december 31 , 2010 , 2009 and 2008 .\",\"year ended december 31 , ( in millions ) 2010 2009 2008 .\"],\"table\":[[\"year ended december 31 ( in millions )\",\"2010\",\"2009\",\"2008\"],[\"u.s .\",\"$ 16568\",\"$ 6263\",\"$ -2094 ( 2094 )\"],[\"non-u.s. ( a )\",\"8291\",\"9804\",\"4867\"],[\"income before incometax expense/ ( benefit ) andextraordinary gain\",\"$ 24859\",\"$ 16067\",\"$ 2773\"]]},\"task_id\":\"JPM/2010/page_273.pdf-2\"}}","role":"user"}],"model":"deepseek-v4-flash","reasoning_effort":"high","response_format":{"type":"json_object"},"stream":false,"thinking":{"type":"enabled"}}