{
  "message": "The reserve for product warranties is reported as $10 million at Dec. 31, 2006 and $4 million at Dec. 31, 2005. The change from 2005 to 2006 is 2006 reserve minus 2005 reserve: 10 - 4 = 6. The source amounts are already in millions, so the result is in USD millions.",
  "tool": "calculate",
  "arguments": {
    "expression": "warranty_2006 - warranty_2005",
    "variables": {
      "warranty_2006": {
        "value": 10,
        "source": "source:q11n3",
        "unit": "USD_million"
      },
      "warranty_2005": {
        "value": 4,
        "source": "source:q11n4",
        "unit": "USD_million"
      }
    },
    "sources": {
      "warranty_2006": "source:q11n3",
      "warranty_2005": "source:q11n4"
    }
  }
