        "event_index": null,
        "kind": "source_text",
        "slot_id": null,
        "source_id": "pre_text:10",
        "text": "the bwe acquisition sup- ports the company 2019s strategy of strengthening its portfolio with fast-growing super-premium and above wines .",
        "turn_index": null
